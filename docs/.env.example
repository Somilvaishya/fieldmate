# FieldMate — required environment/config variable NAMES only. No values, ever.
# Real values live in sites/<site>/site_config.json, never in Git.

# --- Site / bench ---
FM_SITE_URL=
FM_TEST_SITE=
FM_VERIFY_SITE=

# --- Push notifications (Web Push) ---
FM_VAPID_PUBLIC_KEY=
FM_VAPID_PRIVATE_KEY=
FM_VAPID_SUBJECT=

# --- Maps / geocoding (server-side only, never shipped to the PWA) ---
FM_MAPS_API_KEY=
FM_GEOCODE_PROVIDER=

# --- SMS / OTP ---
FM_SMS_PROVIDER=
FM_SMS_API_KEY=
FM_SMS_SENDER_ID=

# --- File storage offload (configure before pilot, not after) ---
FM_S3_ENDPOINT=
FM_S3_BUCKET=
FM_S3_ACCESS_KEY=
FM_S3_SECRET_KEY=

# --- Sync tuning ---
FM_SYNC_BATCH_SIZE=
FM_SYNC_MAX_RETRIES=
FM_PING_INTERVAL_SECONDS=
FM_PHOTO_MAX_KB=

# --- Retention (PII) ---
FM_GPS_TRAIL_RETENTION_DAYS=
FM_SELFIE_RETENTION_DAYS=
