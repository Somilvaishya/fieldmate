 ],
 "fields": [
  {"fieldname": "naming_series", "fieldtype": "Select", "label": "Series", "options": "FM-EXP-.YYYY.-.#####", "default": "FM-EXP-.YYYY.-.#####", "reqd": 1},
  {"fieldname": "claim_date", "fieldtype": "Date", "label": "Date", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1, "search_index": 1,
   "description": "The day in the market being claimed for, which is the day the trail is read against - not the day the rep got round to filing it."},
  {"fieldname": "field_user", "fieldtype": "Link", "label": "Field User", "options": "FieldMate Field User", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1, "search_index": 1},
  {"fieldname": "employee", "fieldtype": "Link", "label": "Employee", "options": "Employee", "read_only": 1,
   "description": "Needed to post an HRMS Expense Claim on approval. Blank where a rep is not on HR, and then the claim still stands and is settled by hand."},
  {"fieldname": "column_head", "fieldtype": "Column Break"},
  {"fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "Company", "reqd": 1},
  {"fieldname": "expense_type", "fieldtype": "Select", "label": "Type",
   "options": "Travel\nFood\nStay\nOther", "default": "Travel", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "claim_status", "fieldtype": "Select", "label": "Status",
   "options": "Draft\nPending Approval\nApproved\nRejected\nSettled\nCancelled",
   "default": "Draft", "reqd": 1, "allow_on_submit": 1, "in_list_view": 1, "in_standard_filter": 1},

  {"fieldname": "section_travel", "fieldtype": "Section Break", "label": "Distance", "depends_on": "eval:doc.expense_type=='Travel'"},
  {"fieldname": "trail_distance_km", "fieldtype": "Float", "label": "Trail Distance (km)", "read_only": 1, "precision": "2",
   "description": "What the GPS trail recorded for this rep on this day. Computed by the server from Location Trail and never accepted from the phone - a distance a device could state is a distance a device could invent."},
  {"fieldname": "claimed_distance_km", "fieldtype": "Float", "label": "Claimed (km)", "precision": "2",
   "description": "What the rep says they travelled. Defaults to the trail. A trail loses pings in a basement and in a market with no signal, so claiming a little more is ordinary; claiming a lot more waits for a manager."},
  {"fieldname": "rate_per_km", "fieldtype": "Currency", "label": "Rate Per Km", "read_only": 1,
   "description": "Copied from Settings at the moment of claiming, not read at approval. A rate that changed in between must not silently restate what a rep was shown on the screen when they submitted."},
  {"fieldname": "column_travel", "fieldtype": "Column Break"},
  {"fieldname": "distance_variance_km", "fieldtype": "Float", "label": "Over Trail (km)", "read_only": 1, "precision": "2"},
  {"fieldname": "distance_variance_pct", "fieldtype": "Percent", "label": "Over Trail", "read_only": 1},
  {"fieldname": "trail_ping_count", "fieldtype": "Int", "label": "Pings", "read_only": 1,
   "description": "How many location readings the trail holds for that day. A claim standing on four pings and one standing on four hundred are different evidence, and the approver can see which."},
  {"fieldname": "day_start", "fieldtype": "Link", "label": "Day Start", "options": "FieldMate Day Start", "read_only": 1},

  {"fieldname": "section_amount", "fieldtype": "Section Break", "label": "Amount"},
  {"fieldname": "computed_amount", "fieldtype": "Currency", "label": "Computed", "read_only": 1,
   "description": "What the rule gives: distance times rate for travel, the daily allowance for food and stay. The rep sees this before they file."},
  {"fieldname": "claimed_amount", "fieldtype": "Currency", "label": "Claimed", "reqd": 1, "in_list_view": 1},
  {"fieldname": "column_amount", "fieldtype": "Column Break"},
  {"fieldname": "approved_amount", "fieldtype": "Currency", "label": "Approved", "allow_on_submit": 1, "in_list_view": 1},
  {"fieldname": "allowance_cap", "fieldtype": "Currency", "label": "Allowance Cap", "read_only": 1,
   "description": "Zero means the type has no cap. Shown rather than silently applied, so a rep who is paid less than they claimed can see which rule did it."},

  {"fieldname": "section_proof", "fieldtype": "Section Break", "label": "Proof"},
  {"fieldname": "receipt", "fieldtype": "Attach Image", "label": "Receipt"},
  {"fieldname": "receipt_required", "fieldtype": "Check", "label": "Receipt Required", "read_only": 1},
  {"fieldname": "column_proof", "fieldtype": "Column Break"},
  {"fieldname": "remarks", "fieldtype": "Small Text", "label": "Remarks",
   "description": "Where the rep went and why. On a travel claim this is the only thing that explains a route the trail shows and a map does not."},

  {"fieldname": "section_approval", "fieldtype": "Section Break", "label": "Approval"},
  {"fieldname": "needs_approval", "fieldtype": "Check", "label": "Needs Approval", "read_only": 1, "in_standard_filter": 1,
   "description": "Set by the server when the claim exceeds what the evidence supports. A rep can always file; what they cannot do is approve their own excess."},
  {"fieldname": "approval_reason", "fieldtype": "Small Text", "label": "Why", "read_only": 1},
  {"fieldname": "approved_by", "fieldtype": "Link", "label": "Approved By", "options": "User", "read_only": 1, "allow_on_submit": 1},
  {"fieldname": "approved_on", "fieldtype": "Datetime", "label": "Approved On", "read_only": 1, "allow_on_submit": 1},
  {"fieldname": "column_approval", "fieldtype": "Column Break"},
  {"fieldname": "rejection_reason", "fieldtype": "Small Text", "label": "Rejection Reason", "allow_on_submit": 1},
  {"fieldname": "hrms_expense_claim", "fieldtype": "Data", "label": "HR Expense Claim", "read_only": 1, "allow_on_submit": 1, "no_copy": 1,
   "description": "The HRMS document raised on approval, where that app is installed. Held as Data rather than a Link so the DocType still installs on a bench without HRMS."},
  {"fieldname": "settled_on", "fieldtype": "Date", "label": "Settled On", "read_only": 1, "allow_on_submit": 1},

  {"fieldname": "section_sync", "fieldtype": "Section Break", "label": "Sync", "collapsible": 1},
  {"fieldname": "client_uuid", "fieldtype": "Data", "label": "Client UUID", "unique": 1, "no_copy": 1},
  {"fieldname": "created_offline", "fieldtype": "Check", "label": "Created Offline", "read_only": 1},
  {"fieldname": "column_sync", "fieldtype": "Column Break"},
  {"fieldname": "device_id", "fieldtype": "Data", "label": "Device", "read_only": 1},
  {"fieldname": "sync_status", "fieldtype": "Select", "label": "Sync", "options": "Pending\nSynced\nConflict", "default": "Synced", "read_only": 1},
  {"fieldname": "amended_from", "fieldtype": "Link", "label": "Amended From", "options": "FieldMate Expense Claim", "read_only": 1, "no_copy": 1, "print_hide": 1}
 ],
