  {"fieldname": "lines", "fieldtype": "Table", "label": "Lines", "options": "FieldMate Target Line", "reqd": 1},

  {"fieldname": "section_cascade", "fieldtype": "Section Break", "label": "Cascade"},
  {"fieldname": "cascade_basis", "fieldtype": "Select", "label": "Split By",
   "options": "Outlet Count\nEqual\nLast Period Achievement", "default": "Outlet Count",
   "description": "How an additive target is divided among the children. Outlet count is the default because a rep with 280 shops cannot carry the same number as one with 90, and it is the one weight every site already has without anybody maintaining it. A ratio target is never split whatever this says."},
  {"fieldname": "child_count", "fieldtype": "Int", "label": "Children", "read_only": 1, "allow_on_submit": 1},
  {"fieldname": "column_cascade", "fieldtype": "Column Break"},
