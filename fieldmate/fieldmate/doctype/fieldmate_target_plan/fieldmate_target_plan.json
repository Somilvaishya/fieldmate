  {"fieldname": "naming_series", "fieldtype": "Select", "label": "Series", "options": "FM-TGT-.YYYY.-.#####", "default": "FM-TGT-.YYYY.-.#####", "reqd": 1},
  {"fieldname": "plan_name", "fieldtype": "Data", "label": "Plan", "reqd": 1, "in_list_view": 1,
   "description": "What this period is called out loud - Diwali push, Q3, September. Carried down to every child so a rep and a sales head are talking about the same thing."},
  {"fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "Company", "reqd": 1},
  {"fieldname": "column_head", "fieldtype": "Column Break"},
