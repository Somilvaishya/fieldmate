  {"fieldname": "to_date", "fieldtype": "Date", "label": "To", "reqd": 1, "in_list_view": 1},
  {"fieldname": "plan_status", "fieldtype": "Select", "label": "Status",
   "options": "Draft\nActive\nCascaded\nClosed\nCancelled", "default": "Draft", "reqd": 1,
   "allow_on_submit": 1, "in_list_view": 1, "in_standard_filter": 1,
   "description": "Cascaded means children exist and this plan is no longer the thing anybody works to - the leaves are. Editing a cascaded plan without re-cascading is how the two stop adding up."},

  {"fieldname": "section_owner", "fieldtype": "Section Break", "label": "Whose Target"},
  {"fieldname": "sales_person", "fieldtype": "Link", "label": "Sales Person", "options": "Sales Person",
   "reqd": 1, "in_list_view": 1, "in_standard_filter": 1, "search_index": 1,
   "description": "ERPNext's own tree, which is what the cascade walks. FieldMate keeps no second hierarchy for this: a company that already maintains one reporting tree should not be asked to maintain two that can disagree."},
  {"fieldname": "field_user", "fieldtype": "Link", "label": "Field User", "options": "FieldMate Field User", "read_only": 1, "in_standard_filter": 1,
   "description": "Resolved from the sales person where one carries a rep. Blank on every level above the leaves, which is how a plan knows it is not somebody's own number yet."},
  {"fieldname": "level", "fieldtype": "Data", "label": "Level", "read_only": 1,
   "description": "How deep in the tree this sits, as a word rather than a number, because the words are what people use: National, Region, Area, Rep."},
  {"fieldname": "column_owner", "fieldtype": "Column Break"},
